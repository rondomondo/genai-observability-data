#!/usr/bin/env python3
"""god-cli - GenAI Observability Data generator CLI.

A rich terminal interface around the god package (src/god).
Run from the repo root; the package is resolved via sys.path.
"""
from __future__ import annotations

import asyncio
import os
import subprocess
import sys
import time
from pathlib import Path

# Resolve src/god from the repo root regardless of cwd
_REPO_ROOT = Path(__file__).resolve().parent
_SRC = _REPO_ROOT / "src"
if str(_SRC) not in sys.path:
    sys.path.insert(0, str(_SRC))

# Re-exec under uv if dependencies are not available (e.g. venv not activated)
try:
    import rich  # noqa: F401
except ImportError:
    _venv = _REPO_ROOT / "src" / "god" / ".venv"
    _uv = subprocess.run(["which", "uv"], capture_output=True, text=True).stdout.strip()
    if not _uv:
        print("ERROR: 'uv' not found and 'rich' is not installed. Run: pip install rich", file=sys.stderr)
        sys.exit(1)
    os.execvp(_uv, [_uv, "run", "--project", str(_REPO_ROOT / "src" / "god"), "python", __file__, *sys.argv[1:]])

import argparse

from rich import box
from rich.console import Console
from rich.live import Live
from rich.panel import Panel
from rich.progress import BarColumn, MofNCompleteColumn, Progress, SpinnerColumn, TextColumn, TimeElapsedColumn
from rich.table import Table
from rich.text import Text
from rich.theme import Theme

THEME = Theme({
    "info": "cyan",
    "success": "bold green",
    "warn": "yellow",
    "error": "bold red",
    "dim": "dim white",
    "heading": "bold blue",
    "scenario": "magenta",
    "value": "bright_white",
})

console = Console(stderr=True, theme=THEME, highlight=False)
out = Console(theme=THEME, highlight=False)  # stdout for piped data


def _header(version: str) -> Panel:
    title = Text("god", style="bold blue", justify="center")
    title.append(f"  v{version}", style="dim")
    sub = Text("GenAI Observability Data Generator", style="dim", justify="center")
    content = Text.assemble(title, "\n", sub)
    return Panel(content, box=box.ROUNDED, border_style="blue", padding=(0, 2))


def _scenario_table() -> Table:
    from god.scenarios import SCENARIO_PRESETS

    t = Table(
        title="Available Scenario Presets",
        box=box.SIMPLE_HEAD,
        border_style="blue",
        header_style="bold cyan",
        show_lines=False,
        padding=(0, 1),
    )
    t.add_column("Preset", style="magenta bold", no_wrap=True)
    t.add_column("Scenarios", style="dim", justify="right")
    t.add_column("Tags", style="cyan")
    t.add_column("Description", style="white")

    for name, factory in SCENARIO_PRESETS.items():
        scenarios = factory()
        if scenarios:
            tags = ", ".join(sorted({tag for s in scenarios for tag in s.tags}))
            desc = "  ".join(f"[dim]{s.name}[/dim]: {s.description}" for s in scenarios)
            t.add_row(name, str(len(scenarios)), tags, desc)
        else:
            t.add_row(name, "0", "-", "[dim](no fault injection)[/dim]")
    return t


def _config_table(
    n_traces: int,
    rate: float,
    scenario: str | None,
    seed: int | None,
    formats: list[str],
    output: str | None,
    otlp: str | None,
    mock: bool,
    capture_content: bool,
    batch_size: int,
) -> Table:
    t = Table(box=box.SIMPLE, show_header=False, padding=(0, 1), border_style="dim")
    t.add_column("key", style="dim", no_wrap=True)
    t.add_column("value", style="value")

    def add(key: str, val: str, style: str = "value") -> None:
        t.add_row(key, Text(val, style=style))

    add("traces", str(n_traces))
    add("rate", f"{rate}/s")
    add("scenario", scenario or "none", style="scenario" if scenario else "dim")
    add("seed", str(seed) if seed is not None else "random")
    add("format", ", ".join(formats))
    add("output", output or ("stdout" if not otlp else "-"))
    if otlp:
        add("otlp", otlp, style="cyan")
    add("batch-size", str(batch_size))
    add("mock", str(mock), style="warn" if mock else "dim")
    add("capture-content", str(capture_content), style="warn" if capture_content else "dim")
    return t


def _analysis_panel(result) -> Panel:  # type: ignore[type-arg]
    lines: list[tuple[str, str]] = [
        ("Active scenarios", ", ".join(result.active_scenarios) if result.active_scenarios else "none"),
        ("Error rate", f"{result.error_rate:.1%}"),
        ("p99 latency", f"{result.p99_latency_ms:.0f} ms"),
    ]
    body = Table.grid(padding=(0, 2))
    body.add_column(style="dim", no_wrap=True)
    body.add_column(style="value")
    for label, value in lines:
        body.add_row(label, value)

    if result.anomaly_signals:
        body.add_row("", "")
        body.add_row("[bold]Anomaly signals[/bold]", "")
        sev_styles = {"critical": "bold red", "high": "red", "medium": "yellow", "low": "dim"}
        for sig in result.anomaly_signals:
            style = sev_styles.get(sig.severity.lower(), "white")
            body.add_row(
                f"  [{style}]{sig.severity.upper()}[/{style}]",
                f"{sig.service} - {sig.signal_type}: {sig.detail}",
            )

    body.add_row("", "")
    body.add_row("Recommendation", result.recommended_action)
    body.add_row("Summary", result.summary)

    return Panel(body, title="[bold cyan]Scenario Analysis[/bold cyan]", box=box.ROUNDED, border_style="cyan")


def parse_args(argv: list[str] | None = None) -> argparse.Namespace:
    """Parse CLI arguments.

    Args:
        argv: argument list; defaults to sys.argv[1:]

    Returns:
        Parsed namespace
    """
    from god.scenarios import SCENARIO_PRESETS

    p = argparse.ArgumentParser(
        prog="god-cli",
        description="Generate synthetic GenAI distributed traces and logs.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        add_help=False,
    )

    p.add_argument("--help", "-h", action="store_true", default=False)
    p.add_argument("--version", "-V", action="store_true", default=False)

    gen = p.add_argument_group("Generation")
    gen.add_argument("--traces", "-n", type=int, default=None, metavar="N")
    gen.add_argument("--rate", type=float, default=None, metavar="N")
    gen.add_argument("--scenario", choices=list(SCENARIO_PRESETS.keys()), default=None, metavar="NAME")
    gen.add_argument("--seed", type=int, default=None, metavar="N")
    gen.add_argument("--capture-content", action="store_true", default=False)

    out_grp = p.add_argument_group("Output")
    out_grp.add_argument("--format", nargs="+", choices=["otlp_traces", "otlp_logs", "logfmt", "loki"],
                         default=["logfmt"], metavar="FMT")
    out_grp.add_argument("--output", "-o", type=str, default=None, metavar="DIR")
    out_grp.add_argument("--otlp", type=str, default=None, metavar="URL")
    out_grp.add_argument("--otlp-header", action="append", default=[], metavar="KEY=VALUE")
    out_grp.add_argument("--compress", action="store_true", default=False)
    out_grp.add_argument("--batch-size", type=int, default=None, metavar="N")

    agent_grp = p.add_argument_group("Agent")
    agent_grp.add_argument("--analyse", action="store_true", default=False)
    agent_grp.add_argument("--agent-model", type=str, default=None, metavar="MODEL")
    agent_grp.add_argument("--mock", action="store_true", default=False)

    meta = p.add_argument_group("Meta")
    meta.add_argument("--list-scenarios", action="store_true", default=False)
    meta.add_argument("--quiet", "-q", action="store_true", default=False)

    return p.parse_args(argv)


def _build_sinks(args: argparse.Namespace):  # type: ignore[return]
    from god.sinks import FileSink, MultiSink, OTLPHttpSink, Sink, StdoutSink

    sinks: list[Sink] = []

    if args.output:
        sinks.append(FileSink(output_dir=args.output, formats=args.format, compress=args.compress))
    elif not args.otlp:
        sinks.append(StdoutSink(include_traces=False))

    if args.otlp:
        headers: dict[str, str] = {}
        for h in args.otlp_header:
            if "=" in h:
                k, v = h.split("=", 1)
                headers[k.strip()] = v.strip()
        sinks.append(OTLPHttpSink(endpoint=args.otlp, headers=headers))

    if not sinks:
        sinks.append(StdoutSink())

    return MultiSink(sinks) if len(sinks) > 1 else sinks[0]


def main(argv: list[str] | None = None) -> int:
    """CLI entry point.

    Args:
        argv: argument list; defaults to sys.argv[1:]

    Returns:
        exit code
    """
    args = parse_args(argv)

    from god import __version__

    if args.version:
        out.print(f"god {__version__}")
        return 0

    if args.help:
        console.print(_header(__version__))
        _print_help()
        return 0

    if args.list_scenarios:
        console.print(_header(__version__))
        console.print(_scenario_table())
        return 0

    from god.config import get_settings
    from god.orchestrator import generate_dataset
    from god.scenarios import ScenarioEngine
    from god.services import ServiceRegistry

    settings = get_settings()
    use_mock = args.mock or settings.mock_mode

    if use_mock:
        from god.mock.activate import activate_mock_mode
        activate_mock_mode()

    n_traces = args.traces or settings.default_traces
    rate = args.rate or settings.default_rate
    batch_size = args.batch_size or settings.default_batch_size

    registry = ServiceRegistry()
    engine: ScenarioEngine | None = None

    if args.scenario:
        engine = ScenarioEngine.from_preset(args.scenario, registry)

    deps = None
    if args.analyse:
        from god.deps import GodDeps
        deps = GodDeps(settings=settings, registry=registry, engine=engine)

    if not args.quiet:
        console.print(_header(__version__))
        console.print(
            Panel(
                _config_table(n_traces, rate, args.scenario, args.seed,
                              args.format, args.output, args.otlp,
                              use_mock, args.capture_content, batch_size),
                title="[bold]Run configuration[/bold]",
                box=box.ROUNDED,
                border_style="dim",
                padding=(0, 1),
            )
        )

    sink = _build_sinks(args)
    base_epoch_ms = time.time() * 1000
    trace_buf: list = []
    log_buf: list = []
    all_traces: list = []
    all_logs: list = []
    generated = 0
    t0 = time.monotonic()

    progress = Progress(
        SpinnerColumn(),
        TextColumn("[info]generating[/info]"),
        BarColumn(bar_width=30),
        MofNCompleteColumn(),
        TextColumn("[dim]traces[/dim]"),
        TimeElapsedColumn(),
        console=console,
        transient=False,
        disable=args.quiet,
    )

    try:
        with progress:
            task = progress.add_task("", total=n_traces)

            for trace, logs in generate_dataset(
                registry=registry,
                n_traces=n_traces,
                base_epoch_ms=base_epoch_ms,
                traces_per_second=rate,
                rng_seed=args.seed,
                engine=engine,
                capture_content=args.capture_content,
            ):
                trace_buf.append(trace)
                log_buf.extend(logs)
                if args.analyse:
                    all_traces.append(trace)
                    all_logs.extend(logs)
                generated += 1
                progress.advance(task)

                if generated % batch_size == 0:
                    sink.flush(trace_buf, log_buf)
                    trace_buf.clear()
                    log_buf.clear()

        if trace_buf or log_buf:
            sink.flush(trace_buf, log_buf)

    finally:
        sink.close()

    elapsed = time.monotonic() - t0
    if not args.quiet:
        tps = generated / elapsed if elapsed > 0 else 0
        console.print(
            Panel(
                f"[success]Done.[/success]  {generated} traces in [value]{elapsed:.2f}s[/value]  "
                f"[dim]({tps:.0f} traces/s)[/dim]",
                box=box.ROUNDED,
                border_style="green",
                padding=(0, 1),
            )
        )

    if args.analyse:
        console.print("[info]Running scenario analysis agent...[/info]")
        result = asyncio.run(
            _run_analysis(all_traces, all_logs, deps, args.agent_model)
        )
        console.print(_analysis_panel(result))

    return 0


async def _run_analysis(traces: list, logs: list, deps, model_override: str | None):  # type: ignore[return]
    from god.agent import analyse_batch
    return await analyse_batch(traces, logs, deps, model_name=model_override)


