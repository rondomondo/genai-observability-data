#!/usr/bin/env python3
"""god-cli -- GenAI Observability Data generator CLI.

A thin wrapper around the god package (src/god) that adds a gen-scenario
subcommand for batch scenario generation.
"""

from __future__ import annotations

import argparse
import asyncio
import os
import shutil
import sys
from pathlib import Path
from typing import Callable

# -----------------------------------------------------------------------------
# Environment & Dependency Bootstrapping
# -----------------------------------------------------------------------------
def _bootstrap_environment() -> Path:
    """Configures sys.path and auto-executes via 'uv' if dependencies are missing."""
    repo_root = Path(__file__).resolve().parent
    src_dir = repo_root / "src"

    if str(src_dir) not in sys.path:
        sys.path.insert(0, str(src_dir))

    try:
        import rich  # noqa: F401
    except ImportError:
        uv_path = shutil.which("uv")
        if not uv_path:
            print(
                "ERROR: 'uv' not found and 'rich' is not installed. Run: pip install rich", 
                file=sys.stderr
            )
            sys.exit(1)
            
        project_path = src_dir / "god"
        os.execvp(uv_path, [uv_path, "run", "--project", str(project_path), "python", __file__, *sys.argv[1:]])

    return repo_root


_REPO_ROOT = _bootstrap_environment()

# Core package imports (safe to import now that environment is established)
from god.cli import _header, _print_help, console, main
from god.config import get_settings
from god.scenarios import SCENARIO_PRESETS

_VALID_FORMATS = ("otlp_traces", "otlp_logs", "logfmt", "loki")


# -----------------------------------------------------------------------------
# Argument Parsing & Argument Construction
# -----------------------------------------------------------------------------
def _build_scenario_parser() -> argparse.ArgumentParser:
    """Builds the argument parser for the gen-scenario subcommand."""
    import argparse

    settings = get_settings()
    p = argparse.ArgumentParser(
        prog="god-cli gen-scenario",
        description="Generate one or all fault-injection scenarios into output/<scenario>/.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    p.add_argument(
        "scenario",
        metavar="SCENARIO",
        nargs="?",
        default=settings.default_scenario,
        choices=[*SCENARIO_PRESETS.keys(), "all", None],
        help="scenario preset name, or 'all' to generate every preset",
    )
    p.add_argument(
        "--traces", "-n",
        type=int,
        default=settings.default_traces,
        metavar="N",
        help=f"traces per scenario (default: {settings.default_traces})",
    )
    p.add_argument(
        "--rate",
        type=float,
        default=settings.default_rate,
        metavar="N",
        help=f"traces/sec (default: {settings.default_rate})",
    )
    p.add_argument(
        "--format",
        nargs="+",
        choices=list(_VALID_FORMATS),
        default=settings.default_format,
        metavar="FMT",
        help=f"output formats (default: {' '.join(settings.default_format)})",
    )
    p.add_argument(
        "--output", "-o",
        type=Path,
        default=Path("./output"),
        metavar="DIR",
        help="root output directory (default: ./output)",
    )
    p.add_argument("--seed", type=int, default=None, metavar="N", help="RNG seed for deterministic output")
    p.add_argument("--otlp", type=str, default=None, metavar="URL", help="stream to OTLP HTTP endpoint instead of files")
    p.add_argument("--otlp-header", action="append", default=[], metavar="KEY=VALUE", help="extra headers for OTLP sink (repeatable)")
    
    # Boolean flags
    p.add_argument("--compress", action="store_true", help="gzip-compress file output")
    p.add_argument("--no-mock", dest="mock", action="store_false", default=True, help="disable mock mode (default: mock on)")
    p.add_argument("--quiet", "-q", action="store_true", help="suppress progress output per scenario")
    
    return p


def _build_god_argv(args: argparse.Namespace, scenario_out: Path) -> list[str]:
    """Translates parsed gen-scenario args into a core god CLI argv list."""
    argv: list[str] = [
        "--traces", str(args.traces),
        "--rate", str(args.rate),
        "--scenario", args.scenario,
        "--format", *args.format,
        "--output", str(scenario_out),
    ]
    
    if args.otlp:
        argv += ["--otlp", args.otlp]
        for header in args.otlp_header:
            argv += ["--otlp-header", header]
            
    if args.seed is not None:
        argv += ["--seed", str(args.seed)]

    # Dynamic boolean flag mapping
    for flag in ("compress", "quiet"):
        if getattr(args, flag):
            argv.append(f"--{flag}")

    if not args.mock:
        argv.append("--no-mock")
            
    return argv


# -----------------------------------------------------------------------------
# Core Logic Execution
# -----------------------------------------------------------------------------
async def _run_scenario(scenario_name: str, args: argparse.Namespace) -> int:
    """Generates data for a single scenario inside an execution thread."""
    scenario_out = args.output / scenario_name
    scenario_out.mkdir(parents=True, exist_ok=True)

    if not args.quiet:
        console.print(f"[info]Generating scenario:[/info] [scenario]{scenario_name}[/scenario]")

    scenario_args = argparse.Namespace(**vars(args), scenario=scenario_name)
    god_argv = _build_god_argv(scenario_args, scenario_out)

    loop = asyncio.get_running_loop()
    return await loop.run_in_executor(None, main, god_argv)


async def _gen_scenario_async(argv: list[str]) -> int:
    """Asynchronous orchestrator for the gen-scenario subcommand."""
    parser = _build_scenario_parser()
    args = parser.parse_args(argv)

    if args.scenario is None:
        parser.error("SCENARIO is required (or set GOD_DEFAULT_SCENARIO)")

    scenarios = list(SCENARIO_PRESETS.keys()) if args.scenario == "all" else [args.scenario]

    # Run all targeted scenarios concurrently
    results = await asyncio.gather(*[_run_scenario(name, args) for name in scenarios])

    if any(rc != 0 for rc in results):
        console.print("[error]One or more scenarios failed to generate.[/error]")
        return 1

    if not args.quiet:
        target_dir = args.output if args.scenario == "all" else args.output / args.scenario
        console.print(f"[success]Scenario generation complete ->[/success] [value]{target_dir}/[/value]")

    return 0


def _gen_scenario(argv: list[str]) -> int:
    """Synchronous entry point that safely invokes the async loop."""
    return asyncio.run(_gen_scenario_async(argv))


# -----------------------------------------------------------------------------
# Subcommand Dispatching & UI Help
# -----------------------------------------------------------------------------
_SUBCOMMANDS: dict[str, tuple[str, Callable[[list[str]], int]]] = {
    "gen-scenario": ("Generate one or all scenarios into output/<scenario>/", _gen_scenario),
}


def _print_wrapper_help(version: str) -> None:
    """Renders a beautiful combined help UI using Rich panels."""
    from rich.box import ROUNDED, SIMPLE
    from rich.panel import Panel
    from rich.table import Table

    console.print(_header(version))

    table = Table(box=SIMPLE, show_header=False, padding=(0, 1), border_style="dim")
    table.add_column("cmd", style="cyan", no_wrap=True)
    table.add_column("desc", style="white")

    table.add_row("[bold dim]Subcommands[/bold dim]", "")
    for name, (desc, _) in _SUBCOMMANDS.items():
        table.add_row(f"  {name}", desc)

    table.add_row("", "")
    table.add_row("[bold dim]Examples[/bold dim]", "")
    table.add_row("  [dim]./god-cli gen-scenario all[/dim]", "Generate all scenarios asynchronously")
    table.add_row("  [dim]./god-cli gen-scenario cascading_failure --traces 200[/dim]", "Single deterministic run")

    table.add_row("", "")
    table.add_row("[bold dim]Core Flags[/bold dim]", "Directly pass core flags to underlying engine (see below)")
    
    console.print(
        Panel(table, title="[bold]Usage[/bold]: god-cli [SUBCOMMAND | OPTIONS]", box=ROUNDED, border_style="blue")
    )
    _print_help(version)


def _dispatch(raw: list[str]) -> int:
    """Dispatches CLI input to either a specialized subcommand or falls back to core."""
    if not raw:
        from god import __version__
        _print_wrapper_help(__version__)
        return 0

    if raw[0] in _SUBCOMMANDS:
        _, command_fn = _SUBCOMMANDS[raw[0]]
        return command_fn(raw[1:])

    return main(raw)


if __name__ == "__main__":
    sys.exit(_dispatch(sys.argv[1:]))