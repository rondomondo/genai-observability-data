    rows = [
        ("Generation", ""),
        ("  -n / --traces N", "Number of traces (default: 100)"),
        ("  --rate N", "Simulated arrival rate in traces/sec (default: 10.0)"),
        ("  --scenario NAME", "Fault injection preset (see --list-scenarios)"),
        ("  --seed N", "RNG seed for deterministic output"),
        ("  --capture-content", "Include gen_ai messages in spans (large, opt-in)"),
        ("", ""),
        ("Output", ""),
        ("  -o / --output DIR", "Write files to DIR instead of stdout"),
        ("  --format FMT...", "otlp_traces | otlp_logs | logfmt | loki"),
        ("  --otlp URL", "Stream to OTLP HTTP endpoint"),
        ("  --otlp-header K=V", "Extra headers for OTLP sink (repeatable)"),
        ("  --compress", "Gzip-compress file output"),
        ("  --batch-size N", "Flush every N traces (default: 50)"),
        ("", ""),
        ("Agent", ""),
        ("  --analyse", "Run pydantic-ai analysis on generated batch"),
        ("  --agent-model MODEL", "Override analysis model"),
        ("  --mock", "Mock mode - no API key or network needed"),
        ("", ""),
        ("Meta", ""),
        ("  --list-scenarios", "List available scenario presets"),
        ("  -q / --quiet", "Suppress progress output"),
        ("  -V / --version", "Show version and exit"),
    ]

    for flag, desc in rows:
        if desc == "":
            t.add_row(Text(flag, style="bold dim"), "")
        else:
            t.add_row(flag, desc)

    console.print(Panel(t, title="[bold]Usage[/bold]: god [OPTIONS]", box=box.ROUNDED, border_style="blue"))


if __name__ == "__main__":
    sys.exit(main())
