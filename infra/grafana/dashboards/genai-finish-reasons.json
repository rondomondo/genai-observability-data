{
  "id": null,
  "uid": "genai-finish-reasons",
  "title": "GenAI - Finish Reasons",
  "tags": ["genai", "otel", "llm"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 2,
  "refresh": "10s",
  "time": { "from": "now-10m", "to": "now" },
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "title": "Finish reason distribution -- last hour",
      "type": "piechart",
      "gridPos": { "x": 0, "y": 0, "w": 8, "h": 10 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({job=~\".+\"} |= \"finish_reason=stop\" [1h]))",
          "legendFormat": "stop"
        },
        {
          "refId": "B",
          "expr": "sum(count_over_time({job=~\".+\"} |= \"finish_reason=length\" [1h]))",
          "legendFormat": "length (truncated)"
        },
        {
          "refId": "C",
          "expr": "sum(count_over_time({job=~\".+\"} |= \"finish_reason=tool_calls\" [1h]))",
          "legendFormat": "tool_calls"
        },
        {
          "refId": "D",
          "expr": "sum(count_over_time({job=~\".+\"} |= \"finish_reason=content_filter\" [1h]))",
          "legendFormat": "content_filter"
        },
        {
          "refId": "E",
          "expr": "sum(count_over_time({job=~\".+\"} |= \"LLM inference failed\" [1h]))",
          "legendFormat": "error"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          { "matcher": { "id": "byName", "options": "stop" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }] },
          { "matcher": { "id": "byName", "options": "length (truncated)" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }] },
          { "matcher": { "id": "byName", "options": "tool_calls" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } }] },
          { "matcher": { "id": "byName", "options": "content_filter" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "purple" } }] },
          { "matcher": { "id": "byName", "options": "error" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] }
        ]
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "pieType": "donut",
        "displayLabels": ["name", "percent"]
      }
    },
    {
      "id": 2,
      "title": "Token-limit truncation rate (finish_reason=length)",
      "type": "stat",
      "gridPos": { "x": 8, "y": 0, "w": 8, "h": 5 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate({job=~\".+\"} |= \"finish_reason=length\" [5m])) / sum(rate({job=~\".+\"} |= \"LLM inference\" [5m]))",
          "legendFormat": "truncation rate"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.03 },
              { "color": "red", "value": 0.10 }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" }
    },
    {
      "id": 3,
      "title": "Error finish rate",
      "type": "stat",
      "gridPos": { "x": 16, "y": 0, "w": 8, "h": 5 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate({job=~\".+\", level=~\"error|ERROR\"} |= \"LLM inference failed\" [5m])) / sum(rate({job=~\".+\"} |= \"LLM inference\" [5m]))",
          "legendFormat": "error rate"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.01 },
              { "color": "red", "value": 0.05 }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" }
    },
    {
      "id": 4,
      "title": "Successful completions/min (stop)",
      "type": "stat",
      "gridPos": { "x": 8, "y": 5, "w": 4, "h": 5 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate({job=~\".+\"} |= \"finish_reason=stop\" [1m])) * 60",
          "legendFormat": "stop/min"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqpm",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" }
    },
    {
      "id": 5,
      "title": "Tool-call completions/min",
      "type": "stat",
      "gridPos": { "x": 12, "y": 5, "w": 4, "h": 5 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate({job=~\".+\"} |= \"finish_reason=tool_calls\" [1m])) * 60",
          "legendFormat": "tool_calls/min"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqpm",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" }
    },
    {
      "id": 6,
      "title": "Total LLM requests/min",
      "type": "stat",
      "gridPos": { "x": 16, "y": 5, "w": 8, "h": 5 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate({job=~\".+\"} |= \"LLM inference\" [1m])) * 60",
          "legendFormat": "total/min"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqpm",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" }
    },
    {
      "id": 7,
      "title": "Finish reasons over time",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 10, "w": 24, "h": 9 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate({job=~\".+\"} |= \"finish_reason=stop\" [1m])) * 60",
          "legendFormat": "stop"
        },
        {
          "refId": "B",
          "expr": "sum(rate({job=~\".+\"} |= \"finish_reason=length\" [1m])) * 60",
          "legendFormat": "length (truncated)"
        },
        {
          "refId": "C",
          "expr": "sum(rate({job=~\".+\"} |= \"finish_reason=tool_calls\" [1m])) * 60",
          "legendFormat": "tool_calls"
        },
        {
          "refId": "D",
          "expr": "sum(rate({job=~\".+\"} |= \"finish_reason=content_filter\" [1m])) * 60",
          "legendFormat": "content_filter"
        },
        {
          "refId": "E",
          "expr": "sum(rate({job=~\".+\", level=~\"error|ERROR\"} |= \"LLM inference failed\" [1m])) * 60",
          "legendFormat": "error"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqpm",
          "custom": { "lineWidth": 1, "fillOpacity": 20, "stacking": { "mode": "normal" } }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "stop" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }] },
          { "matcher": { "id": "byName", "options": "length (truncated)" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }] },
          { "matcher": { "id": "byName", "options": "tool_calls" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } }] },
          { "matcher": { "id": "byName", "options": "content_filter" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "purple" } }] },
          { "matcher": { "id": "byName", "options": "error" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] }
        ]
      },
      "options": { "tooltip": { "mode": "multi" } }
    },
    {
      "id": 8,
      "title": "Finish reason by model -- last hour",
      "type": "bargauge",
      "gridPos": { "x": 0, "y": 19, "w": 12, "h": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (model) (count_over_time({job=~\".+\"} |= \"finish_reason=stop\" | logfmt | model != \"\" [1h]))",
          "legendFormat": "{{model}} stop"
        },
        {
          "refId": "B",
          "expr": "sum by (model) (count_over_time({job=~\".+\"} |= \"finish_reason=length\" | logfmt | model != \"\" [1h]))",
          "legendFormat": "{{model}} truncated"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "horizontal",
        "displayMode": "gradient"
      }
    },
    {
      "id": 9,
      "title": "Truncation warning logs",
      "type": "logs",
      "gridPos": { "x": 12, "y": 19, "w": 12, "h": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "{job=~\".+\"} |= \"finish_reason=length\"",
          "legendFormat": ""
        }
      ],
      "options": {
        "dedupStrategy": "none",
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      }
    }
  ]
}
