{
  "id": null,
  "uid": "workflow-orchestration",
  "title": "Workflow Orchestration",
  "tags": ["genai", "otel", "workflow", "agents"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-10m", "to": "now" },
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "title": "Workflow invocation rate (invocations/min)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate({job=~\".+\"} |~ \"Workflow complete|Workflow failed\" [1m])) * 60",
          "legendFormat": "total invocations/min"
        },
        {
          "refId": "B",
          "expr": "sum(rate({job=~\".+\"} |= \"Workflow complete\" [1m])) * 60",
          "legendFormat": "success"
        },
        {
          "refId": "C",
          "expr": "sum(rate({job=~\".+\"} |= \"Workflow failed\" [1m])) * 60",
          "legendFormat": "failures"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqpm",
          "custom": { "lineWidth": 2, "fillOpacity": 8 }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "failures" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] },
          { "matcher": { "id": "byName", "options": "success" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }] }
        ]
      },
      "options": { "tooltip": { "mode": "multi" } }
    },
    {
      "id": 2,
      "title": "Workflow error rate",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate({job=~\".+\"} |= \"Workflow failed\" [1m])) / sum(rate({job=~\".+\"} |~ \"Workflow complete|Workflow failed\" [1m]))",
          "legendFormat": "workflow error rate"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": { "lineWidth": 2 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.02 },
              { "color": "red", "value": 0.1 }
            ]
          }
        }
      },
      "options": { "tooltip": { "mode": "multi" } }
    },
    {
      "id": 3,
      "title": "Workflow completions -- last hour",
      "type": "stat",
      "gridPos": { "x": 0, "y": 8, "w": 4, "h": 5 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({job=~\".+\"} |= \"Workflow complete\" [1h]))",
          "legendFormat": "completed"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" }
    },
    {
      "id": 4,
      "title": "Workflow failures -- last hour",
      "type": "stat",
      "gridPos": { "x": 4, "y": 8, "w": 4, "h": 5 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({job=~\".+\"} |= \"Workflow failed\" [1h]))",
          "legendFormat": "failures"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" }
    },
    {
      "id": 5,
      "title": "Avg workflow duration (ms)",
      "type": "stat",
      "gridPos": { "x": 8, "y": 8, "w": 4, "h": 5 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "avg(avg_over_time({job=~\".+\"} |= \"Workflow complete\" | logfmt | unwrap duration_ms [1h]))",
          "legendFormat": "avg ms"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 10000 },
              { "color": "red", "value": 30000 }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" }
    },
    {
      "id": 6,
      "title": "Active workflow names -- last hour",
      "type": "bargauge",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 5 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (workflow) (count_over_time({job=~\".+\"} |~ \"Workflow complete|Workflow failed\" | logfmt | workflow != \"\" [1h]))",
          "legendFormat": "{{workflow}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "horizontal",
        "displayMode": "gradient"
      }
    },
    {
      "id": 7,
      "title": "Workflow duration over time (ms)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 13, "w": 12, "h": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "avg(avg_over_time({job=~\".+\"} |= \"Workflow complete\" | logfmt | unwrap duration_ms [1m]))",
          "legendFormat": "avg ms"
        },
        {
          "refId": "B",
          "expr": "quantile_over_time(0.95, {job=~\".+\"} |= \"Workflow complete\" | logfmt | unwrap duration_ms [5m])",
          "legendFormat": "p95 ms"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": { "lineWidth": 2 }
        }
      },
      "options": { "tooltip": { "mode": "multi" } }
    },
    {
      "id": 8,
      "title": "Planning phase duration (ms)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 13, "w": 12, "h": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "avg(avg_over_time({job=~\".+\"} |= \"Agent planning complete\" | logfmt | unwrap duration_ms [1m]))",
          "legendFormat": "plan avg ms"
        },
        {
          "refId": "B",
          "expr": "quantile_over_time(0.95, {job=~\".+\"} |= \"Agent planning complete\" | logfmt | unwrap duration_ms [5m])",
          "legendFormat": "plan p95 ms"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": { "lineWidth": 2 }
        }
      },
      "options": { "tooltip": { "mode": "multi" } }
    },
    {
      "id": 9,
      "title": "Traces -- workflow-orchestrator (Jaeger)",
      "type": "traces",
      "gridPos": { "x": 0, "y": 21, "w": 12, "h": 7 },
      "datasource": { "type": "jaeger", "uid": "jaeger" },
      "targets": [
        {
          "refId": "A",
          "queryType": "search",
          "service": "workflow-orchestrator",
          "limit": 20
        }
      ],
      "options": {}
    },
    {
      "id": 10,
      "title": "Workflow + planning logs",
      "type": "logs",
      "gridPos": { "x": 12, "y": 21, "w": 12, "h": 7 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "{job=~\".+\", service_name=~\"workflow-orchestrator|agent-service\"} |~ \"(Workflow|planning)\"",
          "legendFormat": ""
        }
      ],
      "options": {
        "dedupStrategy": "none",
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      }
    }
  ]
}
