{
  "id": null,
  "uid": "agent-operations",
  "title": "Agent Operations",
  "tags": ["genai", "otel", "agents"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-10m", "to": "now" },
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "title": "Agent operation rate (ops/min)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate({job=~\".+\"} |= \"Agent provisioned\" [1m])) * 60",
          "legendFormat": "create_agent"
        },
        {
          "refId": "B",
          "expr": "sum(rate({job=~\".+\"} |= \"Agent invocation complete\" [1m])) * 60",
          "legendFormat": "invoke_agent (success)"
        },
        {
          "refId": "C",
          "expr": "sum(rate({job=~\".+\"} |= \"Agent invocation failed\" [1m])) * 60",
          "legendFormat": "invoke_agent (error)"
        },
        {
          "refId": "D",
          "expr": "sum(rate({job=~\".+\"} |= \"Agent planning complete\" [1m])) * 60",
          "legendFormat": "plan (success)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqpm",
          "custom": { "lineWidth": 2, "fillOpacity": 8 }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "invoke_agent (error)" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] }
        ]
      },
      "options": { "tooltip": { "mode": "multi" } }
    },
    {
      "id": 2,
      "title": "Agent invocation error rate",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate({job=~\".+\"} |= \"Agent invocation failed\" [1m])) * 60 / (sum(rate({job=~\".+\"} |~ \"Agent invocation\" [1m])) * 60)",
          "legendFormat": "invoke_agent error rate"
        },
        {
          "refId": "B",
          "expr": "sum(rate({job=~\".+\"} |= \"Agent creation failed\" [1m])) * 60 / (sum(rate({job=~\".+\"} |~ \"Agent creation|Agent provisioned\" [1m])) * 60)",
          "legendFormat": "create_agent error rate"
        },
        {
          "refId": "C",
          "expr": "sum(rate({job=~\".+\"} |= \"Agent planning failed\" [1m])) * 60 / (sum(rate({job=~\".+\"} |~ \"Agent planning\" [1m])) * 60)",
          "legendFormat": "plan error rate"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": { "lineWidth": 2 }
        }
      },
      "options": { "tooltip": { "mode": "multi" } }
    },
    {
      "id": 3,
      "title": "Agent create success -- last hour",
      "type": "stat",
      "gridPos": { "x": 0, "y": 8, "w": 4, "h": 5 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({job=~\".+\"} |= \"Agent provisioned\" [1h]))",
          "legendFormat": "created"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" }
    },
    {
      "id": 4,
      "title": "Agent create failures -- last hour",
      "type": "stat",
      "gridPos": { "x": 4, "y": 8, "w": 4, "h": 5 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({job=~\".+\"} |= \"Agent creation failed\" [1h]))",
          "legendFormat": "failures"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" }
    },
    {
      "id": 5,
      "title": "Avg agent invocation duration (ms)",
      "type": "stat",
      "gridPos": { "x": 8, "y": 8, "w": 4, "h": 5 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "avg(avg_over_time({job=~\".+\"} |= \"Agent invocation complete\" | logfmt | unwrap duration_ms [1h]))",
          "legendFormat": "avg ms"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 10000 },
              { "color": "red", "value": 30000 }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" }
    },
    {
      "id": 6,
      "title": "Active agent names -- last hour",
      "type": "bargauge",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 5 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (agent) (count_over_time({job=~\".+\"} |~ \"Agent invocation|Agent provisioned\" | logfmt | agent != \"\" [1h]))",
          "legendFormat": "{{agent}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "purple", "value": null }] }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "horizontal",
        "displayMode": "gradient"
      }
    },
    {
      "id": 7,
      "title": "Avg agent invocation latency (ms)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 13, "w": 12, "h": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "avg(avg_over_time({job=~\".+\"} |= \"Agent invocation complete\" | logfmt | unwrap duration_ms [1m]))",
          "legendFormat": "invoke_agent avg ms"
        },
        {
          "refId": "B",
          "expr": "quantile_over_time(0.95, {job=~\".+\"} |= \"Agent invocation complete\" | logfmt | unwrap duration_ms [5m])",
          "legendFormat": "invoke_agent p95 ms"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": { "lineWidth": 2 }
        }
      },
      "options": { "tooltip": { "mode": "multi" } }
    },
    {
      "id": 8,
      "title": "Planning phase latency (ms)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 13, "w": 12, "h": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "avg(avg_over_time({job=~\".+\"} |= \"Agent planning complete\" | logfmt | unwrap duration_ms [1m]))",
          "legendFormat": "plan avg ms"
        },
        {
          "refId": "B",
          "expr": "quantile_over_time(0.95, {job=~\".+\"} |= \"Agent planning complete\" | logfmt | unwrap duration_ms [5m])",
          "legendFormat": "plan p95 ms"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": { "lineWidth": 2 }
        }
      },
      "options": { "tooltip": { "mode": "multi" } }
    },
    {
      "id": 9,
      "title": "Traces -- agent-service (Jaeger)",
      "type": "traces",
      "gridPos": { "x": 0, "y": 21, "w": 12, "h": 7 },
      "datasource": { "type": "jaeger", "uid": "jaeger" },
      "targets": [
        {
          "refId": "A",
          "queryType": "search",
          "service": "agent-service",
          "limit": 20
        }
      ],
      "options": {}
    },
    {
      "id": 10,
      "title": "Agent operation logs",
      "type": "logs",
      "gridPos": { "x": 12, "y": 21, "w": 12, "h": 7 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "{job=~\".+\", service_name=~\"agent-service|workflow-orchestrator\"} |~ \"(Agent|planning|Workflow)\"",
          "legendFormat": ""
        }
      ],
      "options": {
        "dedupStrategy": "none",
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      }
    }
  ]
}
