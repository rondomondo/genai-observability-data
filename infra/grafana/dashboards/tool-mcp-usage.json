{
  "id": null,
  "uid": "tool-mcp-usage",
  "title": "Tool and MCP Usage",
  "tags": ["genai", "otel", "tools", "mcp"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 2,
  "refresh": "10s",
  "time": { "from": "now-10m", "to": "now" },
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "title": "Tool call rate by type (calls/min)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate({job=~\".+\"} |= \"MCP tool execution\" [1m])) * 60",
          "legendFormat": "MCP (extension)"
        },
        {
          "refId": "B",
          "expr": "sum(rate({job=~\".+\"} |= \"Tool[extension] execution\" [1m])) * 60",
          "legendFormat": "extension (non-MCP)"
        },
        {
          "refId": "C",
          "expr": "sum(rate({job=~\".+\"} |= \"Tool[datastore] execution\" [1m])) * 60",
          "legendFormat": "datastore"
        },
        {
          "refId": "D",
          "expr": "sum(rate({job=~\".+\"} |= \"Tool[function] execution\" [1m])) * 60",
          "legendFormat": "function"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqpm",
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        }
      },
      "options": { "tooltip": { "mode": "multi" } }
    },
    {
      "id": 2,
      "title": "Tool error rate by type",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate({job=~\".+\", level=~\"error|ERROR\"} |= \"MCP tool execution\" [1m])) * 60",
          "legendFormat": "MCP errors/min"
        },
        {
          "refId": "B",
          "expr": "sum(rate({job=~\".+\", level=~\"error|ERROR\"} |= \"Tool[extension] execution\" [1m])) * 60",
          "legendFormat": "extension errors/min"
        },
        {
          "refId": "C",
          "expr": "sum(rate({job=~\".+\", level=~\"error|ERROR\"} |= \"Tool[datastore] execution\" [1m])) * 60",
          "legendFormat": "datastore errors/min"
        },
        {
          "refId": "D",
          "expr": "sum(rate({job=~\".+\", level=~\"error|ERROR\"} |= \"Tool[function] execution\" [1m])) * 60",
          "legendFormat": "function errors/min"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqpm",
          "custom": { "lineWidth": 1 }
        }
      },
      "options": { "tooltip": { "mode": "multi" } }
    },
    {
      "id": 3,
      "title": "Tool calls -- last hour (by type)",
      "type": "stat",
      "gridPos": { "x": 0, "y": 8, "w": 6, "h": 5 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({job=~\".+\"} |= \"MCP tool execution\" [1h]))",
          "legendFormat": "MCP"
        },
        {
          "refId": "B",
          "expr": "sum(count_over_time({job=~\".+\"} |= \"Tool[extension] execution\" [1h]))",
          "legendFormat": "extension"
        },
        {
          "refId": "C",
          "expr": "sum(count_over_time({job=~\".+\"} |= \"Tool[datastore] execution\" [1h]))",
          "legendFormat": "datastore"
        },
        {
          "refId": "D",
          "expr": "sum(count_over_time({job=~\".+\"} |= \"Tool[function] execution\" [1h]))",
          "legendFormat": "function"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "orientation": "vertical" }
    },
    {
      "id": 4,
      "title": "Extension tool error rate",
      "type": "stat",
      "gridPos": { "x": 6, "y": 8, "w": 6, "h": 5 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate({job=~\".+\", level=~\"error|ERROR\"} |~ \"Tool\\[extension\\] execution|MCP tool execution\" [5m])) / sum(rate({job=~\".+\"} |~ \"Tool\\[extension\\] execution|MCP tool execution\" [5m]))",
          "legendFormat": "extension error rate"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.02 },
              { "color": "red", "value": 0.05 }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" }
    },
    {
      "id": 5,
      "title": "Datastore tool error rate",
      "type": "stat",
      "gridPos": { "x": 12, "y": 8, "w": 6, "h": 5 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate({job=~\".+\", level=~\"error|ERROR\"} |= \"Tool[datastore] execution\" [5m])) / sum(rate({job=~\".+\"} |= \"Tool[datastore] execution\" [5m]))",
          "legendFormat": "datastore error rate"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.02 },
              { "color": "red", "value": 0.05 }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" }
    },
    {
      "id": 6,
      "title": "Function tool error rate",
      "type": "stat",
      "gridPos": { "x": 18, "y": 8, "w": 6, "h": 5 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate({job=~\".+\", level=~\"error|ERROR\"} |= \"Tool[function] execution\" [5m])) / sum(rate({job=~\".+\"} |= \"Tool[function] execution\" [5m]))",
          "legendFormat": "function error rate"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.02 },
              { "color": "red", "value": 0.05 }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" }
    },
    {
      "id": 7,
      "title": "Tool call volume by tool name -- last hour",
      "type": "bargauge",
      "gridPos": { "x": 0, "y": 13, "w": 12, "h": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (tool) (count_over_time({job=~\".+\"} |~ \"tool execution\" | logfmt | tool != \"\" [1h]))",
          "legendFormat": "{{tool}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "horizontal",
        "displayMode": "gradient"
      }
    },
    {
      "id": 8,
      "title": "Avg tool execution latency by type (ms)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 13, "w": 12, "h": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "avg(avg_over_time({job=~\".+\"} |= \"MCP tool execution\" | logfmt | unwrap duration_ms [1m]))",
          "legendFormat": "MCP avg ms"
        },
        {
          "refId": "B",
          "expr": "avg(avg_over_time({job=~\".+\"} |= \"Tool[extension] execution\" | logfmt | unwrap duration_ms [1m]))",
          "legendFormat": "extension avg ms"
        },
        {
          "refId": "C",
          "expr": "avg(avg_over_time({job=~\".+\"} |= \"Tool[datastore] execution\" | logfmt | unwrap duration_ms [1m]))",
          "legendFormat": "datastore avg ms"
        },
        {
          "refId": "D",
          "expr": "avg(avg_over_time({job=~\".+\"} |= \"Tool[function] execution\" | logfmt | unwrap duration_ms [1m]))",
          "legendFormat": "function avg ms"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": { "lineWidth": 2 }
        }
      },
      "options": { "tooltip": { "mode": "multi" } }
    },
    {
      "id": 9,
      "title": "Tool execution logs",
      "type": "logs",
      "gridPos": { "x": 0, "y": 21, "w": 24, "h": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "{job=~\".+\"} |~ \"(MCP tool|Tool\\[) execution\"",
          "legendFormat": ""
        }
      ],
      "options": {
        "dedupStrategy": "none",
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      }
    }
  ]
}
