# Copy to .env and fill in values
GEMINI_API_KEY=your-key-here

# Redis — use service name inside compose, localhost outside
REDIS_URL=redis://redis:6379

# Embedding
EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768
EMBED_WORKERS=4

# Semantic cache
CACHE_HIT_THRESHOLD=0.92
CACHE_TTL_SECONDS=3600

# Summariser LLM
SUMMARISER_MODEL=gemini-2.0-flash

# OTEL — point at your collector
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=vecstore-api

# API auth
API_KEY=dev-secret-change-me

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
# god-cli environment configuration

# Anthropic/Gemini API key -- required for --analyse unless GOD_MOCK_MODE=true
ANTHROPIC_API_KEY=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
GEMINI_API_KEY=AQ.Ab8RN6LUIx6-0M04pi3oKbPNDLim83U5lpEt6XmnpQhulb-udg

# Analysis agent embedding model
GOD_EMBEDDING_MODEL='["gemini-embedding-001", "gemini-embedding-2"]'

# Analysis agent model
GOD_AGENT_MODEL=gemini-2.5-flash
GOD_AGENT_MODEL=claude-sonnet-4-6


# Replace the pydantic-ai agent with a stub (no API key or network needed)
GOD_MOCK_MODE=false

# Generation defaults -- all overridable per-run via CLI flags
GOD_DEFAULT_TRACES=1000
GOD_DEFAULT_RATE=10.0
GOD_DEFAULT_BATCH_SIZE=50
#GOD_DEFAULT_SEED=
GOD_DEFAULT_SCENARIO=llm_degradation

# Output defaults
# Space-separated list: otlp_traces otlp_logs logfmt loki
GOD_DEFAULT_FORMAT='["otlp_traces","otlp_logs", "logfmt"]'

# Stream output to this OTLP HTTP endpoint by default (overrides file output)
GOD_DEFAULT_OTLP=http://localhost:4318
