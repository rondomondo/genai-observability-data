# Copy to .env and fill in real values.
# All URL defaults here are for "make dev" (app runs on localhost, services in Docker).
# docker-compose.yml overrides Redis/OTEL/sidecar URLs to Docker DNS names automatically.

# API auth
API_KEY=dev-secret-change-me

# Redis
# make dev: localhost  |  docker compose: redis://redis:6379 (overridden in docker-compose.yml)
REDIS_URL=redis://localhost:6379

# Embedding
# Options: gemini | sentence-transformers | sidecar | mock
EMBED_BACKEND=sidecar
EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768
EMBED_WORKERS=4
# make dev: localhost  |  docker compose: http://embedder-sidecar:8001 (overridden in docker-compose.yml)
EMBED_SIDECAR_URL=http://localhost:8001

# Semantic cache
CACHE_HIT_THRESHOLD=0.92
CACHE_TTL_SECONDS=3600

# Summariser LLM
SUMMARISER_MODEL=claude-haiku-4-5-20251001

# OTEL
# make dev: localhost  |  docker compose: http://otel-collector:4317 (overridden in docker-compose.yml)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=vecstore-api

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Gemini (required when EMBED_BACKEND=gemini)
GEMINI_API_KEY=your-key-here
